{
	"name": "hybrid-product-search-provision",
	"description": "Provisions an ingest pipeline for dense embeddings, a KNN-enabled product index, and a hybrid search pipeline with normalization.",
	"use_case": "Hybrid Product Search",
	"version": {
		"template": "1.1.0",
		"compatibility": ["2.12.0", "3.0.0", "3.6.0"]
	},
	"workflows": {
		"provision": {
			"nodes": [
				{
					"id": "create_ingest_pipeline",
					"type": "create_ingest_pipeline",
					"user_inputs": {
						"pipeline_id": "${{ ingest_pipeline_id }}",
						"configurations": {
							"description": "Generate dense product embeddings at ingest time",
							"processors": [
								{
									"text_embedding": {
										"model_id": "${{ model_id }}",
										"field_map": {
											"embedding_text": "embedding_vector"
										}
									}
								}
							]
						}
					}
				},
				{
					"id": "create_index",
					"type": "create_index",
					"previous_node_inputs": {
						"create_ingest_pipeline": "pipeline_id"
					},
					"user_inputs": {
						"index_name": "${{ index_name }}",
						"configurations": {
							"settings": {
								"number_of_shards": 1,
								"number_of_replicas": 0,
								"index.max_result_window": 10000,
								"index.knn": true,
								"default_pipeline": "${{ ingest_pipeline_id }}",
								"analysis": {
									"normalizer": {
										"lowercase_normalizer": {
											"type": "custom",
											"filter": ["lowercase"]
										}
									},
									"tokenizer": {
										"sku_trigram_tokenizer": {
											"type": "ngram",
											"min_gram": 3,
											"max_gram": 3,
											"token_chars": [
												"letter",
												"digit",
												"punctuation"
											]
										}
									},
									"analyzer": {
										"english_stem": {
											"type": "english"
										},
										"sku_trigram": {
											"type": "custom",
											"tokenizer": "sku_trigram_tokenizer",
											"filter": ["lowercase"]
										}
									}
								}
							},
							"mappings": {
								"properties": {
									"uid": {
										"type": "keyword"
									},
									"skus": {
										"type": "text",
										"analyzer": "sku_trigram",
										"fields": {
											"keyword": {
												"type": "keyword",
												"normalizer": "lowercase_normalizer"
											}
										}
									},
									"styleNumber": {
										"type": "text",
										"fields": {
											"keyword": {
												"type": "keyword"
											},
											"autocomplete": {
												"type": "search_as_you_type",
												"max_shingle_size": 3
											}
										}
									},
									"supplierUid": {
										"type": "keyword"
									},
									"sellerUid": {
										"type": "keyword"
									},
									"brandUid": {
										"type": "keyword"
									},
									"productType": {
										"properties": {
											"uid": {
												"type": "keyword"
											},
											"name": {
												"type": "text",
												"analyzer": "english_stem",
												"fields": {
													"keyword": {
														"type": "keyword"
													},
													"autocomplete": {
														"type": "search_as_you_type",
														"max_shingle_size": 3
													}
												}
											}
										}
									},
									"categoryUids": {
										"type": "keyword"
									},
									"category": {
										"type": "text",
										"analyzer": "english_stem",
										"fields": {
											"keyword": {
												"type": "keyword"
											}
										}
									},
									"brandName": {
										"type": "text",
										"fields": {
											"keyword": {
												"type": "keyword"
											}
										}
									},
									"name": {
										"type": "text",
										"analyzer": "english_stem",
										"fields": {
											"keyword": {
												"type": "keyword"
											},
											"autocomplete": {
												"type": "search_as_you_type",
												"max_shingle_size": 3
											}
										}
									},
									"descriptionPlainText": {
										"type": "text",
										"fields": {
											"keyword": {
												"type": "keyword"
											}
										}
									},
									"keywords": {
										"type": "text",
										"analyzer": "english_stem",
										"fields": {
											"keyword": {
												"type": "keyword"
											}
										}
									},
									"tags": {
										"type": "keyword"
									},
									"colors": {
										"type": "keyword"
									},
									"colorLabels": {
										"type": "keyword"
									},
									"colorLabelsNormalized": {
										"type": "keyword"
									},
									"imageColors": {
										"type": "keyword"
									},
									"imageColorVariantValueIds": {
										"type": "keyword"
									},
									"sizes": {
										"type": "keyword"
									},
									"materials": {
										"type": "keyword"
									},
									"features": {
										"type": "keyword"
									},
									"builderType": {
										"type": "keyword"
									},
									"unitPrice": {
										"type": "float"
									},
									"minPrice": {
										"type": "float"
									},
									"maxPrice": {
										"type": "float"
									},
									"leadTimeDays": {
										"type": "integer"
									},
									"isActive": {
										"type": "boolean"
									},
									"inStock": {
										"type": "boolean"
									},
									"thumbnailUrl": {
										"type": "keyword",
										"index": false
									},
									"popularityScore": {
										"type": "float"
									},
									"conversionScore": {
										"type": "float"
									},
									"marginScore": {
										"type": "float"
									},
									"isFeatured": {
										"type": "integer"
									},
									"minOrderQty": {
										"type": "integer"
									},
									"updatedAt": {
										"type": "date"
									},
									"embedding_text": {
										"type": "text"
									},
									"artworks": {
										"type": "object",
										"enabled": true
									},
									"artworkLayouts": {
										"type": "object",
										"enabled": true
									},
									"variants": {
										"type": "object",
										"enabled": true
									},
									"images": {
										"type": "object",
										"enabled": true
									},
									"prices": {
										"type": "object",
										"enabled": true
									},
									"markup": {
										"properties": {
											"product": {
												"properties": {
													"type": {
														"type": "keyword"
													},
													"amount": {
														"type": "float"
													}
												}
											},
											"decoration": {
												"properties": {
													"type": {
														"type": "keyword"
													},
													"amount": {
														"type": "float"
													}
												}
											}
										}
									},
									"embedding_vector": {
										"type": "knn_vector",
										"dimension": 1536,
										"method": {
											"name": "hnsw",
											"engine": "lucene",
											"space_type": "cosinesimil"
										}
									}
								}
							}
						}
					}
				},
				{
					"id": "create_search_pipeline",
					"type": "create_search_pipeline",
					"user_inputs": {
						"pipeline_id": "${{ search_pipeline_id }}",
						"configurations": {
							"description": "Hybrid score fusion for products search (lexical + semantic)",
							"phase_results_processors": [
								{
									"normalization-processor": {
										"normalization": {
											"technique": "min_max"
										},
										"combination": {
											"technique": "arithmetic_mean",
											"parameters": {
												"weights": [0.6, 0.4]
											}
										}
									}
								}
							]
						}
					}
				}
			],
			"edges": [
				{
					"source": "create_ingest_pipeline",
					"dest": "create_index"
				},
				{
					"source": "create_ingest_pipeline",
					"dest": "create_search_pipeline"
				}
			]
		}
	}
}
