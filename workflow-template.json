{
	"name": "hybrid-product-search-provision",
	"description": "Provisions the products ingest pipeline (dense embeddings) and the hybrid search pipeline. The index itself is created by xpress-service (`yarn create:products-index`), which also creates both pipelines.",
	"use_case": "Hybrid Product Search",
	"version": {
		"template": "1.1.0",
		"compatibility": ["2.12.0", "3.0.0", "3.6.0"]
	},
	"workflows": {
		"provision": {
			"nodes": [
				{
					"id": "create_ingest_pipeline",
					"type": "create_ingest_pipeline",
					"user_inputs": {
						"pipeline_id": "${{ ingest_pipeline_id }}",
						"configurations": {
							"description": "Products search: embedding_text → embedding_vector",
							"processors": [
								{
									"text_embedding": {
										"model_id": "${{ model_id }}",
										"field_map": {
											"embedding_text": "embedding_vector"
										},
										"skip_existing": true,
										"on_failure": [
											{
												"set": {
													"field": "embedding_failed",
													"value": true
												}
											}
										]
									}
								}
							]
						}
					}
				},
				{
					"id": "create_search_pipeline",
					"type": "create_search_pipeline",
					"user_inputs": {
						"pipeline_id": "${{ search_pipeline_id }}",
						"configurations": {
							"description": "Hybrid score fusion for products search (lexical + semantic)",
							"phase_results_processors": [
								{
									"normalization-processor": {
										"normalization": {
											"technique": "min_max"
										},
										"combination": {
											"technique": "arithmetic_mean",
											"parameters": {
												"weights": [0.6, 0.4]
											}
										}
									}
								}
							]
						}
					}
				}
			],
			"edges": [
				{
					"source": "create_ingest_pipeline",
					"dest": "create_search_pipeline"
				}
			]
		}
	}
}
